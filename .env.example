# Cloudflare Services Configuration
# Centralized Cloudflare service settings - easy to manage and switch
# All Cloudflare settings are also available via core.cloudflare module

# ✅ R2 Object Storage
CLOUDFLARE_R2_ACCOUNT_ID=104dbc5609bc33780236c732ecf740dd
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_key_here
CLOUDFLARE_R2_BUCKET_NAME=townmarket

# ✅ Optional: Custom CNAME pointing to R2 bucket
# Uncomment and set if using a custom domain (e.g., files.yourdomain.com)
# CLOUDFLARE_R2_CUSTOM_DOMAIN=files.townmarket.com

# ✅ Bangladeshi SMS Service
SMS_API_KEY=your_sms_api_key_here