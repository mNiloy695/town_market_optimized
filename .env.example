# ─────────────────────────────────────────────────────────────
#  Town Market — environment template
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Django
DEBUG=False
SECRET_KEY=generate_a_long_random_string_here
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# CORS (comma-separated list of allowed frontend origins)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Database
# Postgres via Docker Compose:
# DATABASE_URL=postgresql://townmarket:USE_A_STRONG_DB_PASSWORD@db:5432/townmarket
# Local SQLite dev fallback:
# DATABASE_URL=sqlite:///db.sqlite3
POSTGRES_DB=townmarket
POSTGRES_USER=townmarket
POSTGRES_PASSWORD=USE_A_STRONG_DB_PASSWORD

# Redis / Celery
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Cloudflare R2 (S3-compatible object storage). Leave empty values / unset to
# fall back to local FileSystemStorage (development). Fill all three for R2.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=townmarket
# Optional: custom CNAME. If unset, endpoints/media URLs use the R2 origin.
CLOUDFLARE_R2_CUSTOM_DOMAIN=

# Banglalians SMS gateway
SMS_API_KEY=

# SSLCommerz (LIVE URLs required when DEBUG=False — the app refuses sandbox
# defaults in production)
STORE_ID=
STORE_PASSWORD=
SSLCOMMERZ_API_URL=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php

# bKash Payment Gateway (PGW)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_BASE_URL=https://sandbox.pay.bka.sh/v1.2.0-beta

# Business rules
SHIPPING_FEE=50
commission_percentage=0.10
ORDER_PAYMENT_TIMEOUT_MINUTES=30